### Health Check
GET {{baseUrl}}/healthz

### Create log
# @name createLog
POST {{baseUrl}}/api/v1/events
Content-Type: application/json
X-API-Key: {{accessKey}}

{
  "workspace_id": "{{workspaceId}}",
  "service_id": "{{serviceId}}",
  "level": "error",
  "message": "Database connection timed out while processing transaction",
  "trace_id": "trc_abc123456789",
  "attributes": {
    "user_id": "usr_84920",
    "environment": "production",
    "region": "us-east-1",
    "http_method": "POST",
    "http_endpoint": "/api/v1/checkout",
    "exception": {
      "type": "DatabaseTimeoutError",
      "stack_trace": [
        {"file": "app/services/db.py", "line": 42, "function": "connect"},
        {"file": "app/routers/checkout.py", "line": 118, "function": "process_payment"}
      ]
    }
  }
}

### Get all logs
GET {{baseUrl}}/api/v1/events?page=1&size=2
X-API-Key: {{accessKey}}

### Filter logs by service and level
GET {{baseUrl}}/api/v1/events?service=payment-api&level=INFO&limit=5&offset=0

### Get single log by id
GET {{baseUrl}}/v1/logs/{{logId}}

