# @baseUrl = https://localhost/api
# Alternative direct URL (bypassing Nginx):
@baseUrl = http://localhost:3001

@logId = 8a744ab2-db0c-4754-8448-7368038dea0d

### Health Check
GET {{baseUrl}}/healthz

### Create log
# @name createLog
POST {{baseUrl}}/v1/logs
Content-Type: application/json

{
  "service": "payment-api",
  "environment": "production",
  "level": "INFO",
  "log_message": "Payment processed successfully.",
  "trace_id": "trc_c12e9f45",
  "metadata": {
    "transaction_id": "txn_784512",
    "amount": 99.99,
    "currency": "USD"
  }
}

### Create error log
POST {{baseUrl}}/v1/logs
Content-Type: application/json

{
  "service": "auth-service",
  "environment": "production",
  "level": "ERROR",
  "log_message": "Failed login attempt: invalid credentials provided",
  "trace_id": "trc_auth_8821",
  "metadata": {
    "ip": "192.168.1.100",
    "attempts": 3
  }
}

### Get all logs
GET {{baseUrl}}/v1/logs

### Filter logs by service and level
GET {{baseUrl}}/v1/logs?service=payment-api&level=INFO

### Get single log by id
GET {{baseUrl}}/v1/logs/{{logId}}

# ### Get logs aggregates and error rates
# GET {{baseUrl}}/v1/logs/stats

# ### Get 24-hour log trends
# GET {{baseUrl}}/v1/logs/trends

# ### Get Detected Issues (Fingerprinted Groups)
# GET {{baseUrl}}/v1/logs/issues

