@baseUrl = http://localhost:3001

@logId = a8c2c449-d33a-460f-ba7e-330e52222420
@serviceId = 
@accessKey = 

### Health Check
GET {{baseUrl}}/healthz

### Create log
# @name createLog
POST {{baseUrl}}/v1/events
Content-Type: application/json

{
  "service_id": "svc_sentry_api",
  "timestamp": "2026-11-02T11:04:00Z",
  "level": "ERROR",
  "message": "Database connection timed out while processing transaction",
  "trace_id": "trc_abc123456789",
  "span_id": "spn_7890xyz",
  "exception": {
    "type": "DatabaseTimeoutError",
    "stack_trace": [
      {"file": "app/services/db.py", "line": 42, "function": "connect"},
      {"file": "app/routers/checkout.py", "line": 118, "function": "process_payment"}
    ]
  },
  "attributes": {
    "user_id": "usr_84920",
    "environment": "production",
    "region": "us-east-1",
    "http_method": "POST",
    "http_endpoint": "/api/v1/checkout"
  }
}

### Create error log
POST {{baseUrl}}/v1/logs
Content-Type: application/json

{
  "service": "auth-service",
  "environment": "production",
  "level": "ERROR",
  "log_message": "Failed login attempt: invalid credentials provided",
  "trace_id": "trc_auth_8821",
  "metadata": {
    "ip": "192.168.1.100",
    "attempts": 3
  }
}

### Get all logs
GET {{baseUrl}}/v1/logs?limit=5&offset=10
X-API-Key: your_api_key_here

### Filter logs by service and level
GET {{baseUrl}}/v1/logs?service=payment-api&level=INFO&limit=5&offset=0

### Get single log by id
GET {{baseUrl}}/v1/logs/{{logId}}

